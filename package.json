{
  "name": "@skorotkiewicz/handwired",
  "version": "0.1.1",
  "description": "Build and evaluate differentiable numeric circuits with exact FP32 semantics.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/runtime/numeric-ui-core.d.ts",
      "import": "./dist/runtime/numeric-ui-core.js"
    },
    "./cells": {
      "types": "./dist/runtime/cells.d.ts",
      "import": "./dist/runtime/cells.js"
    },
    "./host-timing": {
      "types": "./dist/runtime/host-timing.d.ts",
      "import": "./dist/runtime/host-timing.js"
    },
    "./prefix-networks": {
      "types": "./dist/runtime/prefix-networks.d.ts",
      "import": "./dist/runtime/prefix-networks.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["circuit", "differentiable", "fp32", "neural-network"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "example": "npm run build && node examples/compare.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
